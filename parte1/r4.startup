# IP de r4 en el enlace hacia r2:
ip addr add 10.255.0.14/30 dev eth0

# IP de r4 en el enlace fuera del arbol hacia r5:
ip addr add 10.255.0.37/30 dev eth1

# IP de r4 en el enlace fuera del arbol hacia r6:
ip addr add 10.255.0.41/30 dev eth2

# Para llegar a otras redes siguiendo el arbol, enviar por r2:
ip route add default via 10.255.0.13

systemctl start frr
