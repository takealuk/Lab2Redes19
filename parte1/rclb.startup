# IP de rclb en el enlace hacia r5 (ISP):
ip addr add 192.168.19.2/30 dev eth0 

# IP de rclb que las PCs de B usan como gateway:
ip addr add 10.19.0.1/25 dev eth1 

# Para llegar al enlace r5-r6 a traves de r5:
ip route add 10.255.0.0/30 via 192.168.19.1

# Para llegar al enlace r6-rint por r5:
ip route add 10.255.0.4/30 via 192.168.19.1

# Para llegar a Internet simulado por r5:
ip route add 8.8.8.0/24 via 192.168.19.1