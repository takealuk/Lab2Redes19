# IP de r1 en el enlace hacia r2:
ip addr add 10.255.0.18/30 dev eth1

# IP de r1 en el enlace hacia r3:
ip addr add 10.255.0.21/30 dev eth2

# IP de r1 en el enlace hacia rint:
ip addr add 10.255.0.26/30 dev eth0

# Para llegar a otras redes siguiendo el arbol, enviar por r2:
ip route add default via 10.255.0.17

# Para alcanzar la red publica de A por r3:
ip route add 203.0.113.12/30 via 10.255.0.22

# Inicia FRR, el servicio de routing que trae el laboratorio base
systemctl start frr
