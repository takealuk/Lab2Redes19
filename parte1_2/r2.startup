# IP de r2 en el enlace hacia r5:
ip addr add 10.255.0.10/30 dev eth3

# IP de r2 en el enlace hacia r4:
ip addr add 10.255.0.13/30 dev eth2

# IP de r2 en el enlace hacia r1:
ip addr add 10.255.0.17/30 dev eth0

# IP de r2 en el enlace fuera del arbol hacia r3:
ip addr add 10.255.0.29/30 dev eth1

# Inicia FRR, el servicio de routing que trae el laboratorio base
systemctl start frr
