# IP de rcla en el enlace hacia r3 (ISP):
ip addr add 203.0.113.14/30 dev eth0

# IP de rcla que la PC de A usa como gateway:
ip addr add 192.168.100.1/24 dev eth1

# Salida hacia el ISP a traves de r3:
ip route add default via 203.0.113.13

# NAT de la LAN de A usando la IP publica de rcla:
iptables -t nat -A POSTROUTING -s 192.168.100.0/24 -o eth0 -j SNAT --to-source 203.0.113.14
