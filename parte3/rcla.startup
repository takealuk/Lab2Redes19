# Gateway de ADMIN:
ip addr add 10.19.0.1/26 dev eth0

# Gateway de DESARROLLO:
ip addr add 10.19.0.129/25 dev eth1

# Gateway de INVITADOS:
ip addr add 10.19.2.1/23 dev eth2

# Gateway de SERVIDORES:
ip addr add 203.0.113.33/27 dev eth3

# IP de rcla en el enlace hacia r3:
ip addr add 203.0.113.14/30 dev eth4

# Salida hacia el ISP por r3:
ip route add default via 203.0.113.13

# NAT de ADMIN hacia el ISP:
iptables -t nat -A POSTROUTING -s 10.19.0.0/26 -o eth4 -j SNAT --to-source 203.0.113.14

# NAT de DESARROLLO hacia el ISP:
iptables -t nat -A POSTROUTING -s 10.19.0.128/25 -o eth4 -j SNAT --to-source 203.0.113.14

# NAT de INVITADOS hacia el ISP:
iptables -t nat -A POSTROUTING -s 10.19.2.0/23 -o eth4 -j SNAT --to-source 203.0.113.14