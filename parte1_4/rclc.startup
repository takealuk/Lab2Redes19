# IP de rclc en el enlace hacia r8 (ISP):
ip addr add 203.0.113.18/30 dev eth0

# IP de rclc que la PC de C usa como gateway:
ip addr add 192.168.101.1/24 dev eth1

# Salida hacia el ISP a traves de r8:
ip route add default via 203.0.113.17

# NAT de la LAN de C usando la IP publica de rclc:
iptables -t nat -A POSTROUTING -s 192.168.101.0/24 -o eth0 -j SNAT --to-source 203.0.113.18