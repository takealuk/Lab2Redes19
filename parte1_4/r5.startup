# IP de r5 en el enlace hacia rclb:
ip addr add 203.0.113.5/30 dev eth4

# IP de r5 en el enlace hacia r6:
ip addr add 10.255.0.1/30 dev eth3

# IP de r5 en el enlace hacia r2:
ip addr add 10.255.0.9/30 dev eth0

# IP de r5 en el enlace fuera del arbol hacia r3:
ip addr add 10.255.0.34/30 dev eth1

# IP de r5 en el enlace fuera del arbol hacia r4:
ip addr add 10.255.0.38/30 dev eth2

# Inicia FRR, el servicio de routing que trae el laboratorio base
systemctl start frr